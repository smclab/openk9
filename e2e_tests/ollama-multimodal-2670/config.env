# Configurazione dello scenario "E2E embedding multimodale Ollama 2670".
# Letta da run.sh (source) e da e2e.py (ambiente).

export SCENARIO="ollama-multimodal-2670"
export COMPOSE_PROJECT="e2e-ollama-2670"

# Tenant: lo schema deve rispettare ^[a-z][a-z0-9]{0,62}$ (niente trattini).
export SCHEMA="e2eollama"
export VHOST="e2eollama.openk9.localhost"

# Datasource / plugin driver / connettore finto
export DS_NAME="e2e-ollama-ds"
export PD_NAME="e2e-ollama-driver"
export FAKE_HOST="e2e-ollama-2670-fake-connector"

# Modello di embedding: un server Ollama con il modello gia' scaricato
# (ollama pull embeddinggemma-2:740m). OLLAMA_URL e' come lo vede il modulo
# di embedding dal suo container, OLLAMA_HOST_URL come lo vede questo host.
export MODEL_NAME="e2e-ollama-embeddinggemma-2"
export OLLAMA_MODEL="embeddinggemma-2:740m"
export OLLAMA_URL="${OLLAMA_URL:-http://host.docker.internal:11434}"
export OLLAMA_HOST_URL="${OLLAMA_HOST_URL:-http://localhost:11434}"
export VECTOR_SIZE="768"

# Content id (il corpus lo disegna make_corpus.py in corpus/)
export BILGE_CONTENT_ID="page-bilge"     # bilge.jpg, "Bilge pump diagram"
export CABIN_CONTENT_ID="page-cabin"     # cabin.jpg, "Cabin interior layout"
export PDF_CONTENT_ID="manual-pdf"       # manual.pdf: elettrico, sentina, interni
export QUERY_TEXT="bilge pump diagram"

# Endpoint dello stack k9.sh (porte dirette, Basic admin:admin)
export TM_URL="http://localhost:8186/api/tenant-manager"
export DS_URL="http://localhost:8187/api/datasource"
export OS_URL="http://localhost:9200"
export SEARCH_URL="https://$VHOST/api/searcher/v1/search"

# Container
export DATASOURCE_CONTAINER="openk9-datasource"
export INGESTION_CONTAINER="openk9-ingestion"
export TENANTMANAGER_CONTAINER="openk9-tenant-manager"
export OPENSEARCH_CONTAINER="opensearch"
export POSTGRES_CONTAINER="postgresql"
export EMBEDDING_CONTAINER="openk9-embedding-module"
