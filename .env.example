# Origin of the identity provider (scheme, host and port) to allow in the admin panel CSP: without it the browser blocks the login.
#AUTH_ORIGIN=https://keycloak.example.com

# Image namespace: change it to pull the images from a different registry.
#IMAGE_GROUP=openk9

# Image tag: change it to run a different build, for example one rebuilt locally.
#IMAGE_TAG=2026.3.0-SNAPSHOT

# Extra compose files loaded by k9.sh with the profile files, separated by ':', e.g. the services of a demo.
#K9_EXTRA_COMPOSE=../my-demo/compose.yaml

# Java heap and container limit: K9_<SERVICE>_XMX, K9_<SERVICE>_MEM_LIMIT (DATASOURCE, TENANT_MANAGER, INGESTION, SEARCHER)
#K9_DATASOURCE_XMX=1280m
#K9_DATASOURCE_MEM_LIMIT=1800m
#K9_TENANT_MANAGER_XMX=192m
#K9_TENANT_MANAGER_MEM_LIMIT=512m
#K9_INGESTION_XMX=512m
#K9_INGESTION_MEM_LIMIT=800m
#K9_SEARCHER_XMX=128m
#K9_SEARCHER_MEM_LIMIT=400m
