# Origin of the identity provider (scheme, host and port) to allow in the admin panel CSP: without it the browser blocks the login.
#AUTH_ORIGIN=https://keycloak.example.com

# Image namespace: change it to pull the images from a different registry.
#IMAGE_GROUP=openk9

# Image tag: change it to run a different build, for example one rebuilt locally.
#IMAGE_TAG=3.0.x-SNAPSHOT

# Active profiles, normally set by k9.sh from its --with=<profile> flags: the seeder only registers plugin drivers whose profile is active.
#OPENK9_PROFILES=
