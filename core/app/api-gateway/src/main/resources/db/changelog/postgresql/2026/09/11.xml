<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
	logicalFilePath="2026/09/11.xml">

	<!-- Delete the route_security rows of the removed
	     DATASOURCE_OAUTH2_SETTINGS_JS route: ApiRoute.valueOf fails on
	     them while loading the tenant. Unlike the api_key rows deleted
	     by 1774486800-2, event replay does not re-insert these, because
	     routesFor(PUBLIC) no longer produces that name. -->
	<changeSet id="1789115212-1" author="openk9">
		<delete tableName="route_security">
			<where>route = 'DATASOURCE_OAUTH2_SETTINGS_JS'</where>
		</delete>
	</changeSet>

</databaseChangeLog>
