{
	"dynamic_templates": [
	  {
		"binary_metadata_strings": {
		  "path_match": "binary.metadata.*",
		  "match_mapping_type": "string",
		  "mapping": {
			"type": "text",
			"fields": {
			  "keyword": {
				"ignore_above": 256,
				"type": "keyword"
			  }
			}
		  }
		}
	  },
	  {
		"binary_metadata_dates": {
		  "path_match": "binary.metadata.*",
		  "match_mapping_type": "date",
		  "mapping": {
			"type": "text",
			"fields": {
			  "keyword": {
				"ignore_above": 256,
				"type": "keyword"
			  }
			}
		  }
		}
	  }
	],
	"properties": {
	  "chunkText": {
		"type": "text",
		"fields": {
		  "keyword": {
			"ignore_above": 256,
			"type": "keyword"
		  }
		}
	  },
	  "number": {
		"type": "integer"
	  },
	  "total": {
		"type": "integer"
	  },
	  "contentId": {
		"type": "text",
		"fields": {
		  "keyword": {
			"ignore_above": 256,
			"type": "keyword"
		  }
		}
	  },
	  "vector": {
		"type": "knn_vector",
		"dimension": {knnVectorDimension}{#if dataType},
		"data_type": "{dataType}",
		"method": {
		  "name": "hnsw",
		  "engine": "{engine}",
		  "space_type": "{spaceType}"
		}{/if}
	  },
	  "next": {
		"properties": {
		  "chunkText": {
			"fields": {
			  "keyword": {
				"type": "keyword",
				"ignore_above": 256
			  }
			},
			"type": "text"
		  },
		  "number": {
			"type": "long"
		  }
		}
      },
	  "binary": {
		"properties": {
		  "id": {
			"type": "keyword"
		  },
		  "name": {
			"type": "text",
			"fields": {
			  "keyword": {
				"ignore_above": 256,
				"type": "keyword"
			  }
			}
		  },
		  "contentType": {
			"type": "keyword"
		  },
		  "sourceUrl": {
			"type": "keyword"
		  },
		  "metadata": {
			"properties": {
			  "page": {
				"type": "integer",
				"ignore_malformed": true
			  },
			  "caption": {
				"type": "text",
				"fields": {
				  "keyword": {
					"ignore_above": 256,
					"type": "keyword"
				  }
				}
			  },
			  "generated": {
				"type": "boolean"
			  }
			}
		  }
		}
	  },
	  "previous": {
		"properties": {
		  "chunkText": {
			"fields": {
			  "keyword": {
				"type": "keyword",
				"ignore_above": 256
			  }
			},
			"type": "text"
		  },
		  "number": {
			"type": "long"
		  }
		}
      }
	}
}