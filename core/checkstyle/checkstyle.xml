<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
	Regole di stile OpenK9, versione iniziale: solo controlli oggettivi e a basso rumore.
	Restano fuori, in attesa di misurarne l'impatto sul codice esistente: Javadoc sui metodi
	public, ordine degli import e OperatorWrap.
-->
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="severity" value="warning"/>
	<property name="tabWidth" value="4"/>
	<property name="fileExtensions" value="java"/>

	<!-- Indentazione con tab: una riga non può iniziare con spazi (esclusa la continuazione Javadoc) -->
	<module name="RegexpSingleline">
		<property name="format" value="^ +(?!\*)\S"/>
		<property name="message" value="Indentare con i tab, non con gli spazi"/>
	</module>

	<module name="LineLength">
		<property name="max" value="100"/>
		<property name="ignorePattern" value="^(package|import) .*|^\s*(//|\*).*https?://\S+"/>
	</module>

	<module name="TreeWalker">
		<module name="AvoidStarImport"/>
		<module name="NeedBraces"/>
		<!-- else, catch e finally vanno su una nuova riga rispetto alla graffa chiusa -->
		<module name="RightCurly">
			<property name="option" value="alone_or_singleline"/>
			<property name="tokens"
				value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE"/>
		</module>
	</module>
</module>
