<databaseChangeLog
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
	objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
	logicalFilePath="db/datasource/2026/10/26-02-changelog.xml"
>

	<changeSet id="1793032966-1" author="openk9">
		<comment>
			The shape of the first dataIndex of a datasource, so that it can
			be exported and imported with the datasource: whether it is a knn
			index, how it is chunked, the embedding configuration, the custom
			settings, the field to embed and the docTypes it is composed of.
		</comment>
		<addColumn tableName="datasource">
			<column name="knn_index" type="BOOLEAN" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="chunk_type" type="VARCHAR2(255)"/>
			<column name="chunk_window_size" type="INTEGER"/>
			<column name="embedding_json_config" type="CLOB"/>
			<column name="settings" type="CLOB"/>
			<column name="embedding_doc_type_field_id" type="NUMBER(38)"/>
		</addColumn>
	</changeSet>

	<changeSet id="1793032966-2" author="openk9">
		<addForeignKeyConstraint baseTableName="datasource"
								 baseColumnNames="embedding_doc_type_field_id"
								 constraintName="fk_datasource_embedding_doc_type_field"
								 onDelete="NO ACTION" onUpdate="NO ACTION"
								 referencedTableName="doc_type_field"
								 referencedColumnNames="id"/>
	</changeSet>

	<changeSet id="1793032966-3" author="openk9">
		<createTable tableName="datasource_doc_types">
			<column name="datasource_id" type="NUMBER(38)">
				<constraints nullable="false" primaryKey="true"
							 primaryKeyName="datasource_doc_types_pkey"/>
			</column>
			<column name="doc_types_id" type="NUMBER(38)">
				<constraints nullable="false" primaryKey="true"
							 primaryKeyName="datasource_doc_types_pkey"/>
			</column>
		</createTable>
	</changeSet>

	<changeSet id="1793032966-4" author="openk9">
		<addForeignKeyConstraint baseTableName="datasource_doc_types"
								 baseColumnNames="datasource_id"
								 constraintName="fk_datasource_doc_types_datasource"
								 onDelete="NO ACTION" onUpdate="NO ACTION"
								 referencedTableName="datasource"
								 referencedColumnNames="id"/>
	</changeSet>

	<changeSet id="1793032966-5" author="openk9">
		<addForeignKeyConstraint baseTableName="datasource_doc_types"
								 baseColumnNames="doc_types_id"
								 constraintName="fk_datasource_doc_types_doc_type"
								 onDelete="NO ACTION" onUpdate="NO ACTION"
								 referencedTableName="doc_type"
								 referencedColumnNames="id"/>
	</changeSet>

	<changeSet id="1793032966-6" author="openk9">
		<comment>
			A datasource that already has a dataIndex takes its shape from the
			one it currently points at, which is what a reindex would copy.
			A datasource without one, or whose index has no value, gets the
			defaults the entity would assign.
		</comment>
		<sql>
			UPDATE datasource d
			SET (knn_index, chunk_type, chunk_window_size, embedding_json_config,
				settings, embedding_doc_type_field_id) = (
				SELECT di.knn_index, di.chunk_type, di.chunk_window_size,
					di.embedding_json_config, di.settings,
					di.embedding_doc_type_field_id
				FROM data_index di
				WHERE di.id = d.data_index_id
			)
			WHERE d.data_index_id IS NOT NULL
		</sql>
		<sql>
			INSERT INTO datasource_doc_types (datasource_id, doc_types_id)
			SELECT d.id, ddt.doc_types_id
			FROM datasource d
			JOIN data_index_doc_types ddt ON ddt.data_index_id = d.data_index_id
		</sql>
		<sql>
			UPDATE datasource SET chunk_type = 'CHUNK_TYPE_DEFAULT'
			WHERE chunk_type IS NULL
		</sql>
		<sql>
			UPDATE datasource SET chunk_window_size = 0
			WHERE chunk_window_size IS NULL
		</sql>
		<sql>
			UPDATE datasource SET embedding_json_config = '{}'
			WHERE embedding_json_config IS NULL
		</sql>
	</changeSet>

</databaseChangeLog>
