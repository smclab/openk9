{
  "name": "openk9-admin-ui",
  "version": "2026.3.0-SNAPSHOT",
  "private": true,
  "homepage": "admin",
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@babel/standalone": "^7.29.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.12.0",
    "cronstrue": "^3.27.0",
    "graphql": "^16.14.2",
    "i18next": "^26.4.2",
    "jsonpath-plus": "^11.1.0",
    "monaco-editor": "^0.57.0",
    "oidc-client-ts": "^3.1.0",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.15",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "vite",
    "start:k9-local": "vite --mode k9-local",
    "build": "tsc && vite build",
    "test": "vitest",
    "fetch-schemas": "node ../scripts/fetch-schemas.js app/datasource",
    "compile-graphql": "yarn fetch-schemas && graphql-codegen --verbose",
    "compile-openapi": "yarn fetch-schemas && openapi-ts",
    "compile-clients": "yarn fetch-schemas && graphql-codegen --verbose && openapi-ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript-operations": "^6.1.8",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@hey-api/openapi-ts": "0.97.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "vite": "^8.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.2"
  }
}
