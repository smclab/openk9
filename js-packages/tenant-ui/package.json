{
  "name": "openk9-tenant",
  "version": "2026.3.0-SNAPSHOT",
  "private": true,
  "homepage": "admin",
  "dependencies": {
    "@apollo/client": "^3.7.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@graphql-codegen/cli": "^2.11.3",
    "@graphql-codegen/typescript": "^2.7.2",
    "@graphql-codegen/typescript-operations": "^2.5.2",
    "@graphql-codegen/typescript-react-apollo": "^3.3.2",
    "@mui/icons-material": "^6.0.2",
    "@mui/material": "^6.0.2",
    "@tanstack/react-query": "^4.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.3.0",
    "@types/node": "^18.6.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.25",
    "graphql": "^16.5.0",
    "openapi-typescript-codegen": "^0.23.0",
    "prettier": "^2.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.3.0",
    "react-virtuoso": "^2.16.4",
    "typescript": "^5.6.2",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "fetch-schemas": "node ../scripts/fetch-schemas.js app/tenant-manager",
    "compile-graphql": "yarn fetch-schemas && graphql-codegen --verbose",
    "compile-openapi": "yarn fetch-schemas && openapi --input ../../core/app/tenant-manager/target/generated/openapi.yaml --output ./src/openapi-generated --name OpenApiRestClient",
    "compile-clients": "yarn fetch-schemas && graphql-codegen --verbose && openapi --input ../../core/app/tenant-manager/target/generated/openapi.yaml --output ./src/openapi-generated --name OpenApiRestClient"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0"
  },
  "devDependencies": {
    "@graphql-codegen/time": "^3.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "vite": "^7.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.2"
  }
}
