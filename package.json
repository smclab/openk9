{
  "name": "openk9",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "husky": "^4.2.3",
    "lerna": "^8.2.4",
    "patch-package": "^6.2.2",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.5.1"
  },
  "scripts": {
    "build": "lerna run build && lerna run --stream build",
    "docker-build": "lerna run --stream docker-build",
    "publish": "lerna publish",
    "format": "lerna run --stream format",
    "lint": "lerna run --stream lint",
    "test": "lerna run --stream test",
    "postinstall": "patch-package"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lerna run --concurrency 1 --stream precommit"
    }
  },
  "resolutions": {
    "lodash": "4.18.1",
    "**/@ardatan/relay-compiler/immutable": "^3.8.4",
    "**/@graphql-tools/executor-graphql-ws/ws": "^8.21.0",
    "**/@graphql-tools/executor-http/dset": "^3.1.4",
    "**/@graphql-tools/executor-legacy-ws/ws": "^8.21.0",
    "**/@graphql-tools/url-loader/ws": "^8.21.0",
    "**/@lerna/create/js-yaml": "^4.3.2",
    "**/@lerna/create/minimatch": "^3.1.4",
    "**/@microsoft/api-extractor/minimatch": "^3.1.4",
    "**/@nx/devkit/minimatch": "^9.0.7",
    "**/graphql-config/minimatch": "^4.2.5",
    "**/lerna/js-yaml": "^4.3.2",
    "**/lerna/minimatch": "^3.1.4",
    "**/nx/minimatch": "^9.0.7",
    "**/styled-components/postcss": "^8.5.18",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0"
  },
  "workspaces": {
    "packages": [
      "js-packages/*",
      "plugins/**/js",
      "!js-packages/openk9-chatbot"
    ]
  }
}
